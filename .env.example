# Environment: local | test | preview | production
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_UPSTREAM_URL=http://api:8000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Local Compose services. Replace with managed TLS URLs in production.
DATABASE_URL=postgresql+asyncpg://equitylens:equitylens@postgres:5432/equitylens
REDIS_URL=redis://redis:6379/0
REQUIRE_REDIS=true

# Demo is credential-free. Live requires the provider values below.
DATA_MODE=demo
PUBLIC_MARKET_DATA_MODE=demo
PUBLIC_MARKET_DATA_LICENSE_ACKNOWLEDGED=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
SEC_USER_AGENT=

# Generate unique values for every deployed environment. Never commit real values.
SECRET_KEY=local-only-change-me-equitylens-secret-key
CSRF_SECRET=local-only-change-me-csrf-secret
CORS_ORIGINS=http://localhost:3000

# Development captures messages as files. Production uses resend only after DNS verification.
EMAIL_PROVIDER=capture
EMAIL_CAPTURE_DIR=/app/captured-emails
EMAIL_FROM=EquityLens <noreply@localhost>
RESEND_API_KEY=
SENDER_DOMAIN_VERIFIED=false
SENDER_POSTAL_ADDRESS=

# Optional production observability and product analytics.
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
RELEASE_SHA=local

DEMO_TASKS_EAGER=false
